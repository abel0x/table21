root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# License texts stay exactly as published.
[{LICENSE,assets/fonts/OFL.txt}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
